# 海豹测试凭据统一配置（复制为 .env 后填写；.env 已被 .gitignore 忽略，不会提交）

# WebUI 地址（含 IP 与端口）
SEALDICE_PANEL_URL=http://127.0.0.1:3211

# WebUI 解锁密码（新装未设密码时留空；新版 1.6+ 脚本会自动按
# PBKDF2-SHA512(password, salt, 1000, 32) 计算哈希后签入，无需浏览器）
SEALDICE_PANEL_PASSWORD=

# 可选：已解锁的 WebUI token（有则脚本直接使用，跳过 signin）
SEALDICE_PANEL_TOKEN=

# qqmcp / NapCat WebSocket 连接地址（ws:// 或 http:// 均可，协议自动识别）
NAPCAT_BASE_URL=ws://127.0.0.1:3001

# NapCat 访问 token（与 NapCat 的 OneBot 配置一致）
NAPCAT_ACCESS_TOKEN=
